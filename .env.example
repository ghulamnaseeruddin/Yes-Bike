# ==============================================================
# YES BIKE — Full-Stack E-Commerce Environment Configuration
# Legacy Vite/Express/MongoDB app only. The Vercel app uses next-app/.env.example.
# Copy this file to .env for local development or configure in
# the legacy app's local environment.
# ==============================================================

# Database: MongoDB connection string (Atlas cluster or local)
MONGO_URI=

# Authentication: Secure random secret key for signing JWT tokens
JWT_SECRET=

# Authentication: JWT token expiration time (e.g., 30d, 7d, 24h)
JWT_EXPIRES_IN=30d

# Security: Allowed frontend origin(s) for CORS, comma-separated if multiple
# (e.g. https://your-project.vercel.app,http://localhost:5173)
# Optional in production when frontend and backend share the same Vercel domain.
CLIENT_URL=

# Local Development Server Port (defaults to 5000)
PORT=5000

# Frontend API Base URL (defaults to /api; override only if using separate API domain)
VITE_API_URL=/api
